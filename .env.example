# Optional secrets — ohne Keys läuft die öffentliche Pinnwand trotzdem.
# Für Admin-Löschen und den Print-Worker in Produktion setzen.

ADMIN_KEY=bitte-austauschen
PRINT_WORKER_KEY=bitte-austauschen

# Kommagetrennte Extra-Wörter für die Blockliste (Kleinschreibung)
# BLOCKLIST=spamwort,nochwas

# Rate-Limit (Defaults: 5 Zettel / 10 Minuten / IP)
# RATE_LIMIT_MAX=5
# RATE_LIMIT_WINDOW_MS=600000

# MAX_MESSAGE_LENGTH=240
